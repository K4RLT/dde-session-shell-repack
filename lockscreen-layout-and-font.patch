+    // 控制中心「字体」设置变化时（字体家族/字号），实时跟随刷新
+    connect(qGuiApp, &QGuiApplication::fontChanged, this, &TimeWidget::applyFonts);
+}
+
+/**
+ * @brief TimeWidget::applyFonts 应用日期/时钟字体：
+ * - 字体家族跟随控制中心设置（带降级 fallback，见 resolveFontFamily）
+ * - 时钟使用系统字体可用的最重字重，并在 T1 基础上进一步放大（CLOCK_SIZE_SCALE）
+ * - 日期使用 Medium 字重
+ */
+void TimeWidget::applyFonts()
+{
+    const QString fontFamily = resolveFontFamily();
+    const QFont::Weight heavyWeight = resolveHeavyWeight(fontFamily);
+
+    // 日期：Medium 字重
+    DFontSizeManager::instance()->bind(m_dateLabel, DFontSizeManager::T6, QFont::Medium);
+    QFont dateFont = m_dateLabel->font();
+    if (!fontFamily.isEmpty()) dateFont.setFamily(fontFamily);
+    m_dateLabel->setFont(dateFont);
+
+    // 时钟：最重字重 + 放大
+    DFontSizeManager::instance()->bind(m_timeLabel, DFontSizeManager::T1, heavyWeight);
+    QFont timeFont = m_timeLabel->font();
+    if (!fontFamily.isEmpty()) timeFont.setFamily(fontFamily);
+    timeFont.setPointSizeF(timeFont.pointSizeF() * CLOCK_SIZE_SCALE);
+    m_timeLabel->setFont(timeFont);
 }
 
