+/**
+ * @brief resolveFontFamily 优先跟随系统（控制中心 - 字体）设置的字体家族，
+ * 如果该字体家族在当前系统上不可用，则依次降级到一组常见的备用字体，
+ * 保证任何情况下都不会回退到 Qt 的匿名默认字体。
+ */
+static QString resolveFontFamily()
+{
+    const QString systemFamily = QGuiApplication::font().family();
+    const QStringList installed = QFontDatabase::families();
+
+    if (!systemFamily.isEmpty() && installed.contains(systemFamily, Qt::CaseInsensitive)) {
+        return systemFamily;
+    }
+
+    static const QStringList fallbacks = {
+        QStringLiteral("Noto Sans"),
+        QStringLiteral("Noto Sans CJK SC"),
+        QStringLiteral("DejaVu Sans"),
+        QStringLiteral("Sans Serif")
+    };
+    for (const QString &fallback : fallbacks) {
+        if (installed.contains(fallback, Qt::CaseInsensitive)) {
+            return fallback;
+        }
+    }
+
+    // 都不可用时，返回系统字体家族（哪怕为空，也交由 Qt 自行选择默认字体，
+    // 不会崩溃，只是不保证跟随控制中心设置）。
+    return systemFamily;
+}
