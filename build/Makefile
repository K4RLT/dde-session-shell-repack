	$(MAKE) $(MAKESILENT) -f CMakeFiles/dde-lock.dir/build.make CMakeFiles/dde-lock.dir/switchos_interface.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/lightdm-deepin-greeter.dir/build.make CMakeFiles/lightdm-deepin-greeter.dir/switchos_interface.cpp.i
.PHONY : switchos_interface.cpp.i

switchos_interface.s: switchos_interface.cpp.s
.PHONY : switchos_interface.s

# target to generate assembly for a file
switchos_interface.cpp.s:
